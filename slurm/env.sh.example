# Environment setup sourced by the sbatch scripts on the compute node.
# Copy to slurm/env.sh and adapt to your cluster. Examples:

# conda:
# module load miniconda3          # or anaconda3, depending on the cluster
# conda activate vpe

# virtualenv:
# source "$HOME/venvs/vpe/bin/activate"

# modules only:
# module load python/3.11 cuda
